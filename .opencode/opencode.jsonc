{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "projectflow": {
      "type": "local",
      "command": [
        "./projectflow-mcp/.venv-mcp/bin/mcp",
        "run",
        "./projectflow-mcp/server.py"
      ],
      "enabled": true
    }
  }
}